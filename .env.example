# Copy to .env and fill in.

# HTTP port (Render injects its own; 3000 for local dev).
PORT=3000

# HMAC secret used to sign activation tokens. The client verifies offline
# against this via a constant baked into the Elyonis build. CHANGE THIS
# BEFORE FIRST DEPLOY (32+ random bytes hex-encoded).
HMAC_SECRET=change-me-to-a-long-random-hex-string

# Bearer token for /api/admin/* endpoints. Long random string, kept off-repo.
ADMIN_TOKEN=change-me-to-another-long-random-string

# PostgreSQL connection string.
#   Local : postgres://postgres:postgres@localhost:5432/elyonis
#   Render: injected automatically from the managed database (see render.yaml).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elyonis
